@model Documento

@{
    ViewData["Title"] = "Menú de Documentos";

    // Se corrige 'id' por 'codigo' para coincidir con la ruta [HttpGet("DescargarDocumento/{codigo:int}")]
    string pdfInicial = ViewBag.PdfUrl as string ?? Url.Action("DescargarDocumento", "Documento", new { codigo = 6001 })!;
    string noDocumento = ViewBag.NoDocumento as string ?? "6001";
    string? error = ViewBag.Error as string;
}

<div class="container-fluid py-2">
    <div class="row">

        <!-- PANEL IZQUIERDO: Categorías desplegables (4 columnas) -->
        <div class="col-lg-4 mb-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h5 class="fw-bold mb-0 text-dark">Categorías de Documentos</h5>
                    <small class="text-muted">Seleccione un documento para visualizarlo</small>
                </div>
                <div class="card-body p-2">

                    <!-- Acordeón / Tarjetas Desplegables -->
                    <div class="accordion accordion-flush" id="accordionCategorias">

                        <!-- Categoría 1 -->
                        <div class="accordion-item border rounded-3 mb-2 overflow-hidden">
                            <h2 class="accordion-header" id="headingOne">
                                <button class="accordion-button fw-bold text-primary collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#catOne" aria-expanded="false" aria-controls="catOne">
                                    Categoría 1: Certificaciones
                                </button>
                            </h2>
                            <div id="catOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#accordionCategorias">
                                <div class="accordion-body p-0">
                                    <div class="list-group list-group-flush">

                                        <!-- Documento 1: Cambia el texto del botón por el nombre deseado -->
                                        <button type="button" class="list-group-item list-group-item-action d-flex align-items-center doc-item active"
                                                onclick="cargarDocumento('@Url.Action("DescargarDocumento", "Documento", new { codigo = 6001 })', 'Certificación de Registro Institucional', this)">
                                            <i class="bi bi-file-earmark-pdf me-2 text-danger"></i>
                                            Certificación de Registro Institucional
                                        </button>

                                        <!-- Documento 2 -->
                                        <button type="button" class="list-group-item list-group-item-action d-flex align-items-center doc-item"
                                                onclick="cargarDocumento('@Url.Action("DescargarDocumento", "Documento", new { codigo = 6002 })', 'Certificación de Adjudicación de Servicios', this)">
                                            <i class="bi bi-file-earmark-pdf me-2 text-danger"></i>
                                            Certificación de Adjudicación de Servicios
                                        </button>

                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Categoría 2 -->
                        <div class="accordion-item border rounded-3 mb-2 overflow-hidden">
                            <h2 class="accordion-header" id="headingTwo">
                                <button class="accordion-button fw-bold text-primary collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#catTwo" aria-expanded="false" aria-controls="catTwo">
                                    Categoría 2: Contratos Generales
                                </button>
                            </h2>
                            <div id="catTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#accordionCategorias">
                                <div class="accordion-body p-0">
                                    <div class="list-group list-group-flush">

                                        <!-- Documento 3 -->
                                        <button type="button" class="list-group-item list-group-item-action d-flex align-items-center doc-item"
                                                onclick="cargarDocumento('@Url.Action("DescargarDocumento", "Documento", new { codigo = 7001 })', 'Contrato Marco de Mantenimiento de Software', this)">
                                            <i class="bi bi-file-earmark-text me-2 text-primary"></i>
                                            Contrato Marco de Mantenimiento de Software
                                        </button>

                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Categoría 3 -->
                        <div class="accordion-item border rounded-3 mb-2 overflow-hidden">
                            <h2 class="accordion-header" id="headingThree">
                                <button class="accordion-button fw-bold text-primary collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#catThree" aria-expanded="false" aria-controls="catThree">
                                    Categoría 3: Informes Institucionales
                                </button>
                            </h2>
                            <div id="catThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#accordionCategorias">
                                <div class="accordion-body p-0">
                                    <div class="list-group list-group-flush">

                                        <!-- Documento 4 -->
                                        <button type="button" class="list-group-item list-group-item-action d-flex align-items-center doc-item"
                                                onclick="cargarDocumento('@Url.Action("DescargarDocumento", "Documento", new { codigo = 8001 })', 'Informe Anual de Auditoría Interna', this)">
                                            <i class="bi bi-file-earmark-pdf me-2 text-danger"></i>
                                            Informe Anual de Auditoría Interna
                                        </button>

                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <!-- PANEL DERECHO: Visualizador del documento seleccionado (8 columnas) -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">

                <!-- Encabezado del visor con el título dinámico -->
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <h5 id="tituloDocumento" class="fw-bold mb-0 text-dark">Certificación de Registro Institucional</h5>
                    <span class="badge" style="background-color: #0d5493;">Vista Previa</span>
                </div>

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-warning border-0 text-center py-3 rounded-3" role="alert">
                        @error
                    </div>
                }
                else
                {
                    <!-- Contenedor iframe del Visor PDF -->
                    <div class="cgr-pdf-container overflow-hidden rounded-3" style="height: 75vh;">
                        <iframe id="pdfFrame" src="@pdfInicial" width="100%" height="100%" style="border: none;">
                            Su navegador no soporta la visualización de documentos en formato PDF.
                        </iframe>
                    </div>
                }

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function cargarDocumento(url, titulo, elemento) {
            // Actualizar el Iframe y el Título del encabezado del visor
            document.getElementById('pdfFrame').src = url;
            document.getElementById('tituloDocumento').innerText = titulo;

            // Cambiar clase activa en los elementos de la lista
            document.querySelectorAll('.doc-item').forEach(item => {
                item.classList.remove('active');
            });
            elemento.classList.add('active');
        }
    </script>
}